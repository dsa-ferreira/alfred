# alfred configuration. Copy to alfred.toml (git-ignored) and adjust.
# Only non-secret settings live here. Secrets come from ALFRED_* environment
# variables; services and MCP servers name theirs with `token_env`, and users
# name their own MCP tokens with `mcp_tokens`.
# Every value shown is the default, except where marked "required".

# The people alfred serves (at least one). Each chats with alfred in their own
# private Telegram chat and has their own conversation, memory and attachments.
# Messages from anyone else are ignored.
[[users]]
# Lowercase letters, digits and hyphens (required). Services name the user
# with it in /notify and /ask, and the AI uses it for reminders ("remind ana").
name = "diogo"
# The user's Telegram user ID (required).
telegram_user_id = 123456789
# How alfred addresses this user, in its replies and its fixed notices. Used as written.
address = "sir"
# Exactly one user is the admin: the default target of /notify and /ask, and
# the only one who can switch brains. Default: false.
admin = true
# The tools this user is offered (default: none). Exact names as the AI sees them,
# a prefix ending in * ("alfred_*", "cookbook_*"), or "*" for every tool.
tools = ["*"]

[[users]]
name = "ana"
telegram_user_id = 987654321
address = "madam"
# alfred's own tools, all of cookbook, and only two of mcparr's.
tools = ["alfred_*", "cookbook_*", "mcparr_find_media", "mcparr_add_media"]
# Per-server token variables for this user, so a server can tell users apart.
# A server not listed here is called with its own token_env. Default: none.
mcp_tokens = { mcparr = "ALFRED_MCP_TOKEN_MCPARR_ANA" }

[ai]
# OpenAI-compatible server; alfred posts to {base_url}/v1/chat/completions.
base_url = "http://ai.lan"
model = "gemma4:26b-a4b-it-qat"
# Whether [ai] model can see images, when no [ai.models] alias names it (see below).
vision = false
# Seconds per model request. Long enough for the AI server to wake and load the model.
request_timeout_s = 300
# Model requests allowed in one turn before it is stopped.
max_requests_per_turn = 12
# Tool results are cut to this many characters before they reach the model.
tool_result_max_chars = 4000
# alfred's IANA timezone, for today's date in the prompt, reminders and search dates.
timezone = "Europe/Lisbon"
# Replaces the built-in butler persona (alfred's voice) when set. Only the voice:
# the built-in operating rules (tools, service notices, /ask) are always sent.
# persona = """..."""

# Brains the admin can switch between from the chat ("set your brain to bonsai"),
# as alias = "model tag" on [ai] base_url. Default: none, only [ai] model.
# [ai] model is the startup brain; it is listed under its tag if no alias names it.
# A brain that can see images is written as a table with vision = true; only
# those are sent images (with [attachments]). vision defaults to false.
# [ai.models]
# gemma = { model = "gemma4:26b-a4b-it-qat", vision = true }
# bonsai = { model = "bonsai-2:27b", vision = true }
# qwen = "qwen3:14b"

[history]
# Most recent conversation entries sent to the model each turn.
max_entries = 30

[queue]
# Retry delay while the AI is unreachable: starts here and doubles up to retry_max_s.
retry_initial_s = 30
retry_max_s = 900

[memory]
# Model that titles and summarises ended conversations, on [ai] base_url. Default: [ai] model.
# summary_model = "gemma4:26b-a4b-it-qat"
# OpenAI-compatible embedding server; alfred posts to {embedding_base_url}/v1/embeddings.
embedding_base_url = "http://ragman.lan"
# Changing the model re-embeds archived conversations in the background.
embedding_model = "nomic-embed-text:v1.5"
# Seconds per embedding request.
embedding_timeout_s = 30
# Text put before stored summaries and before search queries; model-specific (nomic's here).
document_prefix = "search_document: "
query_prefix = "search_query: "
# Largest recalled conversation, in characters; longer ones become summary + transcript end.
recall_max_chars = 32000
# Most transcript characters sent to the summary model; longer ones keep start and end.
summary_input_max_chars = 60000
# Most conversations one search returns.
search_results = 5

[web]
# SearXNG instance for alfred_web_search; alfred queries {searxng_url}/search?format=json.
searxng_url = "http://oracle.lan"
# Most results one web search lists.
search_results = 5
# Characters of page text in one alfred_web_fetch result; the model reads on with start.
fetch_page_chars = 8000
# Seconds for one web search, and for one page fetch including its redirects.
fetch_timeout_s = 20
# Largest page download, in bytes; a bigger page is refused as too large.
fetch_max_bytes = 5000000

[reminders]
# Time used for a reminder on a date with no clock time ("on Friday"), HH:MM.
default_time = "09:00"
# Checks for due reminders run on the clock: every whole minute and every
# check_interval_s within it (at most 60). Reminders are queued at their minute.
check_interval_s = 30

# Photos, image files and PDFs from users. Default: off, text only.
# The files are kept in an S3-compatible bucket (Garage); the key comes from
# ALFRED_S3_ACCESS_KEY_ID and ALFRED_S3_SECRET_ACCESS_KEY, required with this section.
# [attachments]
# S3 endpoint and bucket (required).
# endpoint_url = "http://garage.lan:3900"
# bucket = "alfred"
# region = "garage"
# Largest file accepted, in bytes; at most 20000000, the most a Telegram bot can download.
# max_bytes = 20000000
# How many of the newest user messages send their images (and PDF page 1) to the
# model; older attachments are sent as a handle the model can open with a tool.
# inline_turns = 1
# Characters of a PDF's page 1 text sent with the message that brings it.
# first_page_chars = 4000
# Characters of PDF text in one alfred_read_document result.
# read_chars = 8000
# Longer side, in pixels, of images and rendered PDF pages sent to the model.
# image_max_px = 1536
# Seconds to wait for the rest of an album before queueing it as one message.
# album_wait_s = 2

[mcp]
# Seconds to wait for each server's tool list at the start of a turn.
list_timeout_s = 10
# Seconds to wait for one tool call.
call_timeout_s = 60
# Each server's instructions are cut to this many characters before they reach the model.
instructions_max_chars = 2000

[server]
host = "0.0.0.0"
port = 8080
log_level = "INFO"

# Services allowed to call /notify and /ask. Default: none.
[[services]]
name = "backup"
token_env = "ALFRED_SERVICE_TOKEN_BACKUP"

# MCP servers whose tools the model is offered. Default: none.
[[mcp_servers]]
name = "mcparr"
url = "http://mcparr.lan:8090/mcp"
token_env = "ALFRED_MCP_TOKEN_MCPARR"
exclude_tools = []
# Give the model the instructions this server sends when connecting; false mutes them.
use_server_instructions = true

[[mcp_servers]]
name = "cookbook"
url = "http://cookbook.lan:8080/mcp"
token_env = "ALFRED_MCP_TOKEN_COOKBOOK"
# cookbook has no token scopes; hide the tools alfred shouldn't use.
exclude_tools = ["delete_recipe"]
